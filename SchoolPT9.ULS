
# Divide by 3

# Задание 3: спрашиваем число, пока оно не попадёт в диапазон от 1 до 100
num = int(input("Введите число от 1 до 100: "))
while num > 100 or num <= 0:
    print("Число должно быть от 1 до 100!")
    num = int(input("Введите число от 1 до 100: "))

# Задание 2: пользователь сам вводит кратное число
divisor = int(input("Введите кратное число: "))

# Задание 1: выводим все числа от 1 до введённого, которые делятся на divisor
for i in range(1, num + 1):
    if i % divisor == 0:
        print(i)
