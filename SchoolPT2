# Age
# Количество лет для выхода на пенсию
limit = 65


# Сохраняем в строковой переменной введенное пользователем имя
eesnimi = input("Введите Имя : ")

# Сохраняем в строковой переменной введенное пользователем фамилию
perenimi = input("Введите Фамилию : ")

# Сохраняем в строковой переменной введенное пользователем отчество
isanimi = input("Введите Отчество : ")

# Соединяем 3 переменные (конкатенация) и записываем в другую строковую переменную pei
pei = perenimi + " " + eesnimi + " " + isanimi

# Выводим на экран текст и переменную pei
print("Ваше полное имя : " + pei);

age = input("Введите ваш возраст : ")

# Конвертируем значение строковой переменной в числовой тип Integer и присваиваем значение переменной age
age = int(age)

pension = limit - age

print("Вам на пенсию через {} года/лет".format(pension))
