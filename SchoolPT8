# Guess Number

import random

# Компьютер придумывает число от 1 до 100
compnumber = random.randint(0,100)
print(compnumber)
attempt = 20
print("У вас {0} попыток чтобы отгадать число!".format(attempt))

for i in range(1, attempt) :
    number = int(input('Введите число от 1 до 100: '))
    if compnumber == number :
        print ('Вы угадали! Поздравляем!')
        break
    else :
        if compnumber < number :
            print ('Мое число меньше!')
        if compnumber > number :
            print ('Мое число больше!')
        
        
