# More or Less than 100

# Сохраняем в строковой переменной введенное пользователем слово
text = input('Введите число: ')

# Преобразуем строку типа String в число типа Integer
number = int(text)

if number > 100:
    print("Число больше 100!")
elif number == 100:
    print("Число равно 100!")
else:
    print("Число меньше 100!")
